#!/bin/bash
# Copy project init templates to the target directory.
# Locates the templates directory via the sibling project-templates-path script.
set -euo pipefail

TEMPLATES_DIR="$(project-templates-path)" || exit 1

TARGET_DIR="${1:-.}"

if [ ! -d "$TARGET_DIR" ]; then
    echo "ERROR: Target directory '$TARGET_DIR' does not exist or is not a directory" >&2
    exit 1
fi

# AGENTS.md
if [ ! -f "$TARGET_DIR/AGENTS.md" ]; then
    cp "$TEMPLATES_DIR/agents/AGENTS.md" "$TARGET_DIR/AGENTS.md"
    echo "Created AGENTS.md"
else
    echo "AGENTS.md already exists, skipping"
fi

# CLAUDE.md imports AGENTS.md, then carries Claude-only additions.
if [ ! -f "$TARGET_DIR/CLAUDE.md" ]; then
    cp "$TEMPLATES_DIR/claude/CLAUDE.md" "$TARGET_DIR/CLAUDE.md"
    echo "Created CLAUDE.md"
else
    echo "CLAUDE.md already exists, skipping"
fi

# .rules/
if [ ! -d "$TARGET_DIR/.rules" ]; then
    mkdir -p "$TARGET_DIR/.rules"
    cp "$TEMPLATES_DIR/claude/rules/"*.md "$TARGET_DIR/.rules/"
    echo "Created .rules/ directory"
else
    echo ".rules directory already exists, skipping"
fi

# .context/
if [ ! -d "$TARGET_DIR/.context" ]; then
    mkdir -p "$TARGET_DIR/.context"
    cp "$TEMPLATES_DIR/context/"*.md "$TARGET_DIR/.context/"
    echo "Created .context/ directory"
else
    echo ".context directory already exists, skipping"
fi

# Python pre-commit hook
if [ -f "$TARGET_DIR/requirements.txt" ] || [ -f "$TARGET_DIR/pyproject.toml" ] || [ -f "$TARGET_DIR/setup.py" ]; then
    if ! git -C "$TARGET_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Warning: Not a git repository. Skipping pre-commit hook. Run 'git init' first, then re-run."
    elif HOOKS_DIR="$(git -C "$TARGET_DIR" rev-parse --git-path hooks)" && [ ! -f "$HOOKS_DIR/pre-commit" ]; then
        mkdir -p "$HOOKS_DIR"
        cp "$TEMPLATES_DIR/config/pre-commit" "$HOOKS_DIR/pre-commit"
        chmod +x "$HOOKS_DIR/pre-commit"
        echo "Installed pre-commit hooks with ruff"
    else
        echo "Pre-commit hook already exists"
    fi
fi
