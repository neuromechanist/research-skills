{
  "version": "0.1.0",
  "templates": [
    {
      "id": "brain-eeg",
      "name": "Brain with EEG Electrodes",
      "category": "neuroscience",
      "tags": ["brain", "eeg", "electrodes", "recording", "neural"],
      "description": "Side-view brain silhouette with small electrode dots on the scalp surface and thin bundled wires",
      "elements": [
        {
          "id": "brain",
          "shape": "organic-silhouette",
          "description": "Simplified brain silhouette in side view, visible cortical folds as smooth curves, no fine detail",
          "fill": "#2D7D9A",
          "stroke": "none",
          "position": "center",
          "size": "primary",
          "z_index": 0
        },
        {
          "id": "electrodes",
          "shape": "circle-array",
          "description": "7 small circles evenly spaced along the top surface of the brain silhouette",
          "fill": "#E8734A",
          "stroke": "none",
          "position": "on:brain:top-surface",
          "size": "tiny",
          "count": 7,
          "z_index": 1
        },
        {
          "id": "wires",
          "shape": "thin-lines",
          "description": "Thin lines from each electrode converging upward into a single bundle",
          "stroke": "#4A4A4A",
          "stroke_width": 1,
          "position": "from:electrodes:top",
          "z_index": 0.5
        }
      ],
      "composition": {
        "background": "transparent",
        "canvas_size": 1024,
        "margin_percent": 12,
        "alignment": "center",
        "style": "flat-minimalist"
      },
      "palette": {
        "primary": "#2D7D9A",
        "secondary": "#E8734A",
        "accent": "#F5C242",
        "neutral": "#4A4A4A"
      },
      "prompt_hints": ["side view", "simplified cortical folds", "electrodes as small dots", "no text or labels"]
    },
    {
