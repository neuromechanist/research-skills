#!/usr/bin/env bash
# Run the deterministic repository checks used by pull-request CI.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

# Project plugin helpers plus every bundled .sh script; fail if none are found.
if [ ! -d plugins/project/scripts ]; then
    echo "ERROR: plugins/project/scripts is missing" >&2
    exit 1
fi
shell_scripts=()
while IFS= read -r script; do
    shell_scripts+=("$script")
done < <(find plugins/project/scripts -type f; find plugins -name '*.sh' -type f)
if [ "${#shell_scripts[@]}" -eq 0 ]; then
    echo "ERROR: no shell scripts found to syntax-check" >&2
    exit 1
fi
for script in "${shell_scripts[@]}"; do
    bash -n "$script"
done

uv run --with pytest --with lxml --with svgelements --with shapely \
    --with svgpathtools --with fonttools --with pyyaml \
    pytest tests/ -q

uv run --with pytest --with pillow --with jsonschema \
    --with pytesseract --with lxml --with svgelements --with shapely \
    --with svgutils --with cairosvg \
    pytest plugins/figures/tests -q

uv sync --group docs
uv run mkdocs build --strict

printf 'Validation complete: shell syntax, tests, manifests, skills, and docs passed.\n'
